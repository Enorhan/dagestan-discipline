# Supabase Configuration
# Get these from your Supabase project settings: https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe Configuration
# Get these from your Stripe dashboard: https://dashboard.stripe.com/apikeys
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
NEXT_PUBLIC_STRIPE_PREMIUM_PRICE_ID=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Mux Configuration
# Get these from your Mux dashboard: https://dashboard.mux.com
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=
MUX_WEBHOOK_SECRET=
MUX_SIGNING_PRIVATE_KEY=

# Data Expansion Pipeline Configuration
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_CX=
BRAVE_SEARCH_API_KEY=
PIPELINE_BRAVE_MIN_INTERVAL_MS=1100
YOUTUBE_API_KEY=
OPENAI_API_KEY=
PIPELINE_USER_AGENT=DagestaniDiscipleDataPipeline/1.0
PIPELINE_ALLOW_BING_RSS_WEB_SEARCH=false
PIPELINE_MAX_ITEMS_PER_SOURCE=8
PIPELINE_SOURCE_LIMIT=25
PIPELINE_EXTRACT_LIMIT=150
PIPELINE_QUEUE_LIMIT=150
PIPELINE_REVIEW_LIMIT=300
PIPELINE_PUBLISH_LIMIT=300
PIPELINE_AUTO_APPROVE_THRESHOLD=0.78
PIPELINE_AUTO_REJECT_THRESHOLD=0.28
PIPELINE_VIDEO_ONLY=true
PIPELINE_VIDEO_RELEVANCE_THRESHOLD=0.45
PIPELINE_WEB_RELEVANCE_THRESHOLD=0.35
PIPELINE_WEB_MAX_TEXT_CHARS=18000
PIPELINE_FRAME_INTERVAL_SECONDS=10
PIPELINE_MAX_FRAMES=12
PIPELINE_MAX_VIDEO_SECONDS=1200
PIPELINE_VIDEO_WORKDIR=.pipeline_artifacts/video_ingest
PIPELINE_KEEP_VIDEO_ARTIFACTS=true
PIPELINE_YTDLP_BIN=yt-dlp
PIPELINE_FFMPEG_BIN=ffmpeg
PIPELINE_TRANSCRIPTION_MODEL=whisper-1
PIPELINE_VISION_MODEL=gpt-4o-mini
PIPELINE_EXTRACTION_MODEL=gpt-4o-mini
PIPELINE_PUBLISH_DRILLS_FROM_EVENTS=true
PIPELINE_PUBLISH_ROUTINES_FROM_EVENTS=false

# App Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_GOOGLE_WEB_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=
GOOGLE_IOS_REVERSED_CLIENT_ID=
NEXT_PUBLIC_CHECKOUT_REDIRECT_URL=
NEXT_PUBLIC_RELEASE_VERSION=dev-local
# If set, JSON is fetched on load and cached; must include flags you expect (e.g. socialFeedEnabled) or rely on defaults.
NEXT_PUBLIC_RUNTIME_FLAGS_URL=
NEXT_PUBLIC_BILLING_CHECKOUT_ENABLED=true
NEXT_PUBLIC_BILLING_PORTAL_ENABLED=true
NEXT_PUBLIC_PREMIUM_UPSELL_ENABLED=true
# Gates the social feed and the Instagram-style You tab; baked at build time (next build / export).
NEXT_PUBLIC_SOCIAL_FEED_ENABLED=true
NEXT_PUBLIC_SOCIAL_STORIES_ENABLED=true
NEXT_PUBLIC_SOCIAL_REELS_ENABLED=true
NEXT_PUBLIC_SOCIAL_EXPLORE_ENABLED=true
NEXT_PUBLIC_SOCIAL_CREATOR_DRAFTS_ENABLED=true
NEXT_PUBLIC_SOCIAL_SCHEDULING_ENABLED=true
NEXT_PUBLIC_SOCIAL_MODERATION_ENABLED=true
NEXT_PUBLIC_SUPPORT_EMAIL=support@dagestanidisciple.com
NEXT_PUBLIC_BILLING_SUPPORT_EMAIL=support@dagestanidisciple.com
NEXT_PUBLIC_PRIVACY_POLICY_URL=/legal/privacy-policy.html
NEXT_PUBLIC_TERMS_OF_SERVICE_URL=/legal/terms-of-service.html

# Optional client-side monitoring sink (for example an ingest webhook or edge function URL)
NEXT_PUBLIC_MONITORING_WEBHOOK_URL=

# Sentry crash reporting (web + Capacitor iOS).  When unset, Sentry is fully no-op.
# DSN is also gated by the in-app analytics consent toggle.
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=

# When set to 1, loads Figma MCP html-to-design capture helper (design workflows only)
NEXT_PUBLIC_FIGMA_CAPTURE=

# Social video pipeline (server-side)
SOCIAL_VIDEO_PROVIDER=mux
SOCIAL_VIDEO_WEBHOOK_TOKEN=
SOCIAL_SCHEDULER_TOKEN=
CLOUDFLARE_STREAM_ACCOUNT_ID=
CLOUDFLARE_STREAM_API_TOKEN=
